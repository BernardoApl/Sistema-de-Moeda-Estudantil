+package com.moedaestudantil.service;
+
+import com.moedaestudantil.model.Professor;
+import org.junit.jupiter.api.Test;
+import static org.assertj.core.api.Assertions.*;
+
+class ProfessorCreditoTest {
+    @Test
+    void acumulaSemEstourarInteiro() {
+        Professor professor = new Professor();
+        professor.setSaldo(25);
+        professor.creditar(1000);
+        assertThat(professor.getSaldo()).isEqualTo(1025);
+        professor.setSaldo(Integer.MAX_VALUE);
+        assertThatThrownBy(() -> professor.creditar(1000)).isInstanceOf(ArithmeticException.class);
+        assertThat(professor.getSaldo()).isEqualTo(Integer.MAX_VALUE);
+    }
+}
